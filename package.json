{
  "name": "meu-dia",
  "version": "2.0.0",
  "description": "Agenda pessoal com tarefas, lembretes e recorrência, com avisos no Slack. Cloudflare Workers + D1.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "db:create": "wrangler d1 create meu-dia",
    "db:migrate:local": "wrangler d1 migrations apply meu-dia --local",
    "db:migrate": "wrangler d1 migrations apply meu-dia --remote"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
