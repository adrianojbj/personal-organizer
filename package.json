{
  "name": "personal-organizer",
  "version": "1.0.0",
  "description": "Personal organizer with Slack integration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "start": "node server/index.js",
    "build": "npm --prefix web run build",
    "install:all": "npm install && npm --prefix web install"
  },
  "dependencies": {
    "@slack/bolt": "^3.21.4",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
