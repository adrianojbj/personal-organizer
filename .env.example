# Slack Bot Token (xoxb-...) - from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token (xapp-...) - from Basic Information, requires connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# Your Slack user ID (used for owner notifications, e.g. U01234567)
OWNER_SLACK_ID=U00000000

# Server port
PORT=3001
